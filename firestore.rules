// NOTE: este arquivo não é aplicado automaticamente — não há pipeline de
// deploy via Firebase CLI neste repo (o hosting é GitHub Pages, não Firebase
// Hosting). Publique manualmente em: Firebase Console > Firestore Database >
// Rules > colar este conteúdo > Publish. Mesmo passo manual já usado pra
// habilitar os provedores de login.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/accounts/{accountId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.type in ['corrente', 'poupanca', 'carteira', 'investimento']
        && request.resource.data.balance is number
        && request.resource.data.currency == 'BRL'
        // Tolerante a ausência: contas criadas antes deste campo existir
        // nunca tiveram `includeInTotal` persistido, e uma escrita parcial
        // de saldo (ex: confirmar pagamento, ajuste de fatura, transferência)
        // resulta num documento final mesclado que ainda não o tem — exigir
        // sempre o campo quebraria toda escrita de saldo nessas contas.
        && (!request.resource.data.keys().hasAny(['includeInTotal']) || request.resource.data.includeInTotal is bool);
    }

    match /users/{userId}/caixinhas/{caixinhaId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.accountId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.balance is number;
    }

    match /users/{userId}/cards/{cardId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.brand is string
        && request.resource.data.limit is number && request.resource.data.limit >= 0
        && request.resource.data.closingDay is number
        && request.resource.data.closingDay >= 1 && request.resource.data.closingDay <= 31
        && request.resource.data.dueDay is number
        && request.resource.data.dueDay >= 1 && request.resource.data.dueDay <= 31;
    }

    match /users/{userId}/categories/{categoryId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.type in ['expense', 'income']
        && request.resource.data.icon is string
        && request.resource.data.color is string;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.type in ['expense', 'income']
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.description is string
        && request.resource.data.categoryId is string
        && request.resource.data.paid is bool
        && (
          (request.resource.data.keys().hasAny(['accountId']) && !request.resource.data.keys().hasAny(['cardId']))
          || (request.resource.data.keys().hasAny(['cardId']) && !request.resource.data.keys().hasAny(['accountId']))
        );
    }

    match /users/{userId}/recurringRules/{ruleId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.description is string
        && request.resource.data.categoryId is string
        && request.resource.data.dayOfMonth is number
        && request.resource.data.dayOfMonth >= 1 && request.resource.data.dayOfMonth <= 31
        && request.resource.data.generatedUntil is string
        && (
          (request.resource.data.keys().hasAny(['accountId']) && !request.resource.data.keys().hasAny(['cardId']))
          || (request.resource.data.keys().hasAny(['cardId']) && !request.resource.data.keys().hasAny(['accountId']))
        );
    }

    // NOTE: escrever numa transação também escreve o `balance` da conta
    // vinculada (runTransaction em transactions/api.ts, payCardInvoice,
    // depositToCaixinha/withdrawFromCaixinha, transferBetweenAccounts) — a
    // regra de `accounts` acima cobre isso: um update parcial só de
    // `balance` resulta no doc final mesclado com os campos antigos, que
    // precisa continuar batendo com a validação de shape já existente
    // mesmo pra contas antigas sem `includeInTotal` persistido (daí a
    // checagem tolerante a ausência nesse campo específico).

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
